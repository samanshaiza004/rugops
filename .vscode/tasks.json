{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Rugops demo",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/build.sh",
            "group": "build"
        },
        {
            "label": "Run headless tests",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/test.sh",
            "group": "test"
        },
        {
            "label": "Run headless invite scenario",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/headless.sh",
            "args": ["scenario", "invite"]
        }
    ]
}
